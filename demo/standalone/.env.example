# Optional overrides for disposable local administrator accounts only.
# All defaults and the imported demo user's password are public dev fixtures.
# The browser origin is fixed to http://localhost:8088 across both OIDC clients.
KEYCLOAK_ADMIN_USER=demo-admin
KEYCLOAK_ADMIN_PASSWORD=development-only-keycloak-admin
GRAFANA_ADMIN_USER=demo-admin
GRAFANA_ADMIN_PASSWORD=development-only-grafana-admin
