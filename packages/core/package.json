  "description": "Private provider-neutral core skeleton for Dashboard Render SDK G; never publish.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "yarn --cwd ../.. tsc6 -b packages/core/tsconfig.json --pretty false",
